# GoldSwingTraderAI local configuration template.
# Copy to .env locally. Never commit real credentials/tokens/keys.

GSTAI_ENV=development
GSTAI_PREFERRED_SYMBOL=XAUUSDm
GSTAI_SYMBOL_ALIASES=XAUUSDm,XAUUSD
GSTAI_MANUAL_RESET_ENABLED=false
GSTAI_STATE_DIR=.state
GSTAI_LOG_LEVEL=INFO

# Optional non-secret account identity pinning.
# Account login is treated as an identifier, not an authentication secret.
GSTAI_ALLOWED_ACCOUNT_LOGIN=
GSTAI_ALLOWED_SERVER=

# V1 DEMO permission is NOT a toggle. Broker writes require positive runtime
# verification that the connected MT5 account is DEMO.

# Financial-authority credentials are intentionally NOT included here.
# Configure them separately through local/secure credential storage only when
# an implementation phase actually requires them.
