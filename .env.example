# GoldSwingTraderAI local configuration template.
# Copy to .env locally. Never commit real credentials/tokens/keys.

GSTAI_ENV=development
GSTAI_PREFERRED_SYMBOL=XAUUSDm
GSTAI_SYMBOL_ALIASES=XAUUSDm,XAUUSD
GSTAI_MANUAL_RESET_ENABLED=false
GSTAI_STATE_DIR=.state
GSTAI_LOG_LEVEL=INFO

# Safe default: read-only MT5 readiness. A healthy/non-retryable snapshot exits;
# stale/insufficient/sparse data remains in the read-only monitor when the
# keep-alive setting below is enabled. PRIMARY/STANDBY run the integrated
# startup/recovery composition and persistent management loop, but remain
# fail-closed until every required live authority is verified.
GSTAI_RUNTIME_MODE=READINESS

# READINESS remains read-only. When enabled, stale/insufficient/sparse market
# data keeps the process alive and polling until data recovers or Ctrl+C is
# pressed. It never grants broker-write authority.
GSTAI_READINESS_KEEP_ALIVE=true
GSTAI_READINESS_POLL_SECONDS=30

# EXISTING refuses a missing risk-day record. INITIALIZE may create the first
# UTC risk-day baseline only when the local state store is otherwise empty.
# RESTORE verifies GSTAI_RESTORE_CHECKPOINT and restores only to a new DB.
GSTAI_STATE_MODE=EXISTING
GSTAI_RESTORE_CHECKPOINT=

# Optional non-secret account identity pinning.
# Account login is treated as an identifier, not an authentication secret.
GSTAI_ALLOWED_ACCOUNT_LOGIN=
GSTAI_ALLOWED_SERVER=

# Required only for PRIMARY/STANDBY. These are broker-write/reconciliation
# identifiers, not credentials; choose and verify them for the target DEMO.
GSTAI_MT5_MAGIC=
GSTAI_MT5_DEVIATION_POINTS=
GSTAI_MT5_COMMENT_PREFIX=GSTAI
# Required for live entry checks; do not guess this value. Calibrate from
# verified healthy XAU broker quotes and keep it in local non-secret config.
GSTAI_HEALTHY_SPREAD_BASELINE=

# Optional provider-neutral session/news handoff. The JSON file must be an
# atomically refreshed, account/server/symbol-scoped snapshot; absent, invalid,
# future-dated or stale input remains UNKNOWN and blocks new authority.
GSTAI_SESSION_NEWS_FILE=
GSTAI_SESSION_NEWS_TTL_SECONDS=1800

# V1 DEMO permission is NOT a toggle. Broker writes require positive runtime
# verification that the connected MT5 account is DEMO.

# Financial-authority credentials are intentionally NOT included here.
# Configure them separately through local/secure credential storage only when
# an implementation phase actually requires them.
